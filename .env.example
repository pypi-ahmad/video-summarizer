# Copy this file to .env and fill in your own keys.
# On the original dev machine these are already set as system environment
# variables, so no .env is needed there - python-dotenv never overrides an
# already-set env var.

# Required for OpenAI (chat + embeddings). OPENAI_BASE_URL is optional -
# only set it if you're routing through a proxy/gateway instead of the
# default OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Required for the Agnes AI backend (agnes-2.5-flash).
AGNES_API_KEY=

# Required for the Google Gemini backends (gemini-3.5-flash-lite, gemini-3.7-flash).
GOOGLE_API_KEY=
